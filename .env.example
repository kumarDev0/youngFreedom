# ─────────────────────────────────────────────────────────────
#  Never commit the real .env file. Put these in Render →
#  Dashboard → Environment. If any key was ever shared in a
#  chat, email or screenshot, rotate it before going live.
# ─────────────────────────────────────────────────────────────

NODE_ENV=production
APP_URL=https://youngfreedom.in

# MongoDB Atlas — use a user that CANNOT drop databases
MONGODB_URI=mongodb+srv://app_user:PASSWORD@cluster0.xxxxx.mongodb.net/youngfreedom?retryWrites=true&w=majority
# M0 free tier caps connections hard. Raise this only after upgrading to M10.
MONGO_POOL_SIZE=10

# Payment mode: CASHFREE (default) or MANUAL_UPI (temporary stopgap while a
# gateway's KYC is pending). Switching back is just this one variable.
PAYMENT_MODE=CASHFREE

# Only needed when PAYMENT_MODE=MANUAL_UPI
MANUAL_UPI_ID=yourname@okaxis
MANUAL_UPI_NAME=YoungFreedom

# Cashfree Payments
# Dashboard → Developers → API Keys. Use SANDBOX until KYC is approved.
CASHFREE_CLIENT_ID=xxxxxxxxxxxxxxxx
CASHFREE_CLIENT_SECRET=xxxxxxxxxxxxxxxx
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Use the SAME value here and in Cashfree Dashboard → Webhooks → Secret.
CASHFREE_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx
# SANDBOX while testing, PRODUCTION once KYC is approved and live keys are in use.
CASHFREE_ENV=SANDBOX

# Cloudinary
CLOUDINARY_CLOUD_NAME=xxxxxxxx
CLOUDINARY_API_KEY=xxxxxxxxxxxx
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxx
CLOUDINARY_RESUME_FOLDER=youngfreedom/resumes

# Sessions / tokens — generate with: openssl rand -base64 48
AUTH_SECRET=change_me_48_random_bytes

# Cloudflare Turnstile (invisible captcha on the public form)
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Upstash Redis — optional at launch, required once you run 2+ instances
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
